@{
    # Fill this in once per engagement. Anything left blank shows as a
    # [placeholder] in the document so it's easy to spot and complete in Word.

    ConsultantCompany = 'Konsultbolaget'         # your company (cover + support section)
    Author            = 'Fardin Barashi'         # "Utarbetad av"
    CustomerName      = 'Kundens namn'            # the customer this documents

    DocumentId        = 'Systemdokumentation Entra ID'
    Version           = '1.0'

    # Optional logo images (PNG). Leave blank to show a text placeholder.
    ConsultantLogo    = ''
    CustomerLogo      = ''

    # Support / contacts (free text, one line each)
    ContactConsultant = ''                        # e.g. 'Name - email - phone'
    ContactCustomer   = ''

    # Initial version-history row (Version / Date / Changed by / Change)
    FirstChange       = 'Första utkast'
}
